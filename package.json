{
  "name": "omrjs",
  "version": "2.0.1",
  "description": "Answer sheet parsing and data extraction using Optical Mark Recognition (OMR) in pure JavaScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./marker.png": "./marker.png",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/worker.d.ts",
      "import": "./dist/worker/worker.js"
    }
  },
  "files": [
    "dist",
    "marker.png"
  ],
  "sideEffects": [
    "./dist/worker/worker.js"
  ],
  "scripts": {
    "test": "npm run build && node --test test/*.test.js",
    "build": "node scripts/build-marker.js && tsc -b",
    "prepublishOnly": "npm run build",
    "example": "npm run build && vite example",
    "format": "biome check --write",
    "release:dry-run": "semantic-release --dry-run",
    "release": "semantic-release"
  },
  "keywords": [
    "omr",
    "optical-mark-recognition",
    "answer-sheet",
    "scantron",
    "bubble-sheet",
    "form-recognition",
    "image-processing"
  ],
  "author": "Taylor Hoffmann <taylor@hoffmann.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaylorHo/omrjs.git"
  },
  "bugs": {
    "url": "https://github.com/TaylorHo/omrjs/issues"
  },
  "homepage": "https://github.com/TaylorHo/omrjs#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "jpeg-js": "^0.4.4",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^6.4.6"
  }
}
